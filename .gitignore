# Boot Image
e200_boot_gen/build_sdimg/BOOT.bin
e200_boot_gen/system_top.bit

# Overlay DTC sources
PYNQ-PRIO/device_tree_overlays/dtc-1.4.4/

# Misc
.vscode/
*.bak
*.fc32
*.ic16
*.hex
**/__pycache__
# Generated build artifacts. These were previously committed, which made
# `make dtbo` a silent no-op (pl.dtbo appeared up to date) and made
# `make sdimg` fail outright (build_sdimg/ already existed, and the recipe
# used a bare `mkdir`).
PYNQ-PRIO/boards/*/prio_linux/dtbo/*.dtbo
e200_boot_gen/build_sdimg/
e200_boot_gen/system_top.bit
PYNQ-PRIO/device_tree_overlays/dtc-1.4.4/
PYNQ-PRIO/device_tree_overlays/dtc-v1.4.4.tar.gz

# Generated by `make dtbo` (copied from PYNQ-PRIO). Committing it made the
# deployed overlay independent of prio_linux/dtso/pl.dts.
boards/e200/base/pl.dtbo
